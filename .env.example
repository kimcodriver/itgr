# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only — never exposed to client. Used by BFF route handlers + server actions.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Restrict Google OAuth to this hosted domain (Autocorp Workspace)
ALLOWED_EMAIL_DOMAIN=autocorp.co.th

# App
NEXT_PUBLIC_APP_NAME="Autocorp ITGR Audit Tracker"
APP_ENV=development
