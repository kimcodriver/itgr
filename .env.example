# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only — never exposed to client. Used by BFF route handlers + server actions.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional Google OAuth hosted-domain restriction.
# Leave unset to allow any Google account to sign in (new users default to
# role=observer, audit_lead must promote them). Set to a domain to restrict, e.g.:
#   ALLOWED_EMAIL_DOMAIN=autocorp.co.th
# ALLOWED_EMAIL_DOMAIN=

# App
NEXT_PUBLIC_APP_NAME="ITGR Audit Tracker"
APP_ENV=development
